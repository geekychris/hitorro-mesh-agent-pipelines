<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.hitorro</groupId>
    <artifactId>hitorro-mesh-agent-pipelines</artifactId>
    <version>3.0.1</version>
    <packaging>jar</packaging>

    <name>hitorro-mesh-agent-pipelines</name>
    <description>
        Agent-side extension for hitorro-mesh-pipelines. Bridges the mesh's
        task-dispatch protocol to the pipelines runtime so nodes declared in
        a JobSpec can execute on remote agents, not just the driver.

        Drop this jar onto a hitorro-mesh-agent-app deployment and Spring
        Boot autoconfig wires a PipelineAgent bean that subscribes to
        mesh.agent.pipeline.&lt;agentId&gt;. TaskDescriptor.pipelineNodeSpec
        (String YAML/JSON) messages are decoded via JobSpecYaml, wrapped in
        a one-node synthetic JobSpec, executed locally through a JobRunner,
        and rows are published back to result subjects.

        Advertises the pipeline-node capability so the driver's dispatcher
        (a future slice's PipelineScheduler) can target agents that have
        this jar installed.
    </description>

    <properties>
        <hitorro.deploy.repo.path>${user.home}/code/hitorro-maven</hitorro.deploy.repo.path>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-mesh-core</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>com.hitorro</groupId>
            <artifactId>hitorro-mesh-pipelines</artifactId>
            <version>3.0.1</version>
        </dependency>
        <dependency>
            <groupId>io.nats</groupId>
            <artifactId>jnats</artifactId>
            <version>2.17.7</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-autoconfigure</artifactId>
            <version>3.2.5</version>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.10.1</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.24.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>

    <distributionManagement>
        <repository>
            <id>hitorro-local</id>
            <url>file://${hitorro.deploy.repo.path}</url>
        </repository>
    </distributionManagement>
</project>
